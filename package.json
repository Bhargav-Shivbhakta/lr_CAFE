{
  "name": "living-room-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "tokens": "node design-system/scripts/build-tokens.mjs",
    "design": "node design-system/scripts/check-design.mjs",
    "design:self-test": "node design-system/scripts/check-design.mjs --self-test",
    "check": "npm run tokens && npm run design:self-test && npm run design && npm run test:engine && npm run test:notify && npm run test:mascot",
    "photos": "node tools/photos/process.mjs",
    "test:engine": "node engine/test.mjs",
    "test:notify": "node --experimental-strip-types engine/notify.test.mjs",
    "test:mascot": "node --experimental-strip-types design-system/mascot/engine.test.mjs",
    "qa:ui": "node tools/qa/ui-check.mjs",
    "qa:copy": "python3 tools/qa/copy-check.py && python3 tools/qa/copy-check.py --self-test",
    "qa:security": "node tools/qa/security-check.mjs",
    "qa:ai": "node tools/qa/ai-review.mjs",
    "qa": "npm run qa:security && npm run qa:calendar && npm run qa:ui && npm run qa:copy && npm run qa:ai; node tools/qa/report.mjs",
    "daily": "npm run check && npm run qa",
    "qa:calendar": "node tools/qa/calendar-check.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^25.18.1",
    "sharp": "^0.35.5"
  }
}
